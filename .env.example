# Docker Hub
DOCKERHUB_USERNAME=your_dockerhub_username
FRONTEND_TAG=latest
BACKEND_TAG=latest

# Let's Encrypt
ACME_EMAIL=your@email.com

# Traefik dashboard basic auth
# Generate with: echo $(htpasswd -nB admin) | sed 's/\$/\$\$/g'
TRAEFIK_DASHBOARD_AUTH=admin:$$2y$$05$$...

# PostgreSQL
DB_USER=beerpong
DB_PASSWORD=changeme
